 "html": "<div style=\"font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto;\">\n  <div style=\"text-align: center; border-bottom: 3px solid #4f46e5; padding-bottom: 12px; margin-bottom: 20px;\">\n    <h1 style=\"margin: 0; color: #4f46e5;\">{{ doc.centre_name or \"Tuition Center\" }}</h1>\n    <p style=\"margin: 4px 0; color: #666;\">Fee Invoice</p>\n  </div>\n\n  <div style=\"display: flex; justify-content: space-between; margin-bottom: 20px;\">\n    <div>\n      <strong>Student:</strong> {{ doc.student_name }}<br>\n      <strong>Student ID:</strong> {{ doc.student }}<br>\n      <strong>Course:</strong> {{ doc.course or \"-\" }}<br>\n      <strong>Batch:</strong> {{ doc.batch or \"-\" }}\n    </div>\n    <div style=\"text-align: right;\">\n      <strong>Invoice:</strong> {{ doc.name }}<br>\n      <strong>Term:</strong> {{ doc.academic_term or \"-\" }}<br>\n      <strong>Due Date:</strong> {{ frappe.utils.formatdate(doc.due_date) if doc.due_date else \"-\" }}\n    </div>\n  </div>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n    <thead>\n      <tr style=\"background: #4f46e5; color: white;\">\n        <th style=\"padding: 10px; text-align: left;\">Description</th>\n        <th style=\"padding: 10px; text-align: right;\">Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr style=\"border-bottom: 1px solid #eee;\">\n        <td style=\"padding: 10px;\">Tuition Fee - {{ doc.academic_term or \"Course\" }}</td>\n        <td style=\"padding: 10px; text-align: right;\">{{ frappe.utils.fmt_money(doc.fee_amount, currency=doc.currency) }}</td>\n      </tr>\n    </tbody>\n    <tfoot>\n      <tr style=\"font-weight: bold;\">\n        <td style=\"padding: 10px;\">Total Fee</td>\n        <td style=\"padding: 10px; text-align: right;\">{{ frappe.utils.fmt_money(doc.fee_amount, currency=doc.currency) }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 10px;\">Paid to Date</td>\n        <td style=\"padding: 10px; text-align: right;\">{{ frappe.utils.fmt_money(doc.paid_amount, currency=doc.currency) }}</td>\n      </tr>\n      <tr style=\"background: #eef2ff; font-weight: bold;\">\n        <td style=\"padding: 10px;\">Outstanding</td>\n        <td style=\"padding: 10px; text-align: right;\">{{ frappe.utils.fmt_money(doc.outstanding_amount, currency=doc.currency) }}</td>\n      </tr>\n    </tfoot>\n  </table>\n\n  <div style=\"margin-top: 24px; color: #666; font-size: 12px; text-align: center;\">\n    <p>This is a system-generated invoice. Please quote invoice number with payments.</p>\n  </div>\n</div>",
